#!/bin/bash

# omyvoid:summary=Temporarily toggle passwordless sudo for the current user
# omyvoid:args=[MINUTES]
# omyvoid:requires-sudo=true

set -euo pipefail

minutes=${1:-15}
[[ $minutes =~ ^[1-9][0-9]*$ ]] || { echo "Usage: omyvoid sudo passwordless [MINUTES]" >&2; exit 2; }
rule=/etc/sudoers.d/99-omyvoid-nopasswd-$USER
pidfile=/run/omyvoid-nopasswd-$USER.pid

if sudo test -f "$rule"; then
  sudo rm -f "$rule"
  if sudo test -f "$pidfile"; then
    sudo kill "$(sudo cat "$pidfile")" 2>/dev/null || true
    sudo rm -f "$pidfile"
  fi
  echo "Passwordless sudo disabled."
  exit 0
fi

gum confirm "Enable passwordless sudo for $minutes minutes?" || exit 130
printf '%s ALL=(ALL:ALL) NOPASSWD: ALL\n' "$USER" | sudo tee "$rule" >/dev/null
sudo chmod 0440 "$rule"
sudo setsid sh -c 'sleep "$1"; rm -f "$2" "$3"' sh "$((minutes * 60))" "$rule" "$pidfile" >/dev/null 2>&1 &
pid=$!
printf '%s\n' "$pid" | sudo tee "$pidfile" >/dev/null
echo "Passwordless sudo enabled for $minutes minutes."
