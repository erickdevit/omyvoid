#!/bin/bash

# omyvoid:summary=Share clipboard, files, or folders with LocalSend
# omyvoid:group=share
# omyvoid:name=
# omyvoid:args=<clipboard|file|folder> [path...]
# omyvoid:examples=omyvoid share clipboard | omyvoid share file ~/Downloads/example.txt

if (($# == 0)); then
  echo "Usage: omyvoid-menu-share [clipboard|file|folder]"
  exit 1
fi

MODE="$1"
shift

if [[ $MODE == "clipboard" ]]; then
  TEMP_FILE=$(mktemp --suffix=.txt)
  wl-paste >"$TEMP_FILE"
  FILES="$TEMP_FILE"
else
  if (($# > 0)); then
    FILES="$*"
  else
    if [[ $MODE == "folder" ]]; then
      # Pick a single folder from home directory
      FILES=$(find "$HOME" -type d 2>/dev/null | fzf)
    else
      # Pick one or more files from home directory
      FILES=$(find "$HOME" -type f 2>/dev/null | fzf --multi)
    fi
    [[ -z $FILES ]] && exit 0
  fi
fi

# Detach LocalSend from the calling terminal.
# Convert newline-separated files to space-separated arguments
if [[ $MODE != "clipboard" ]] && echo "$FILES" | grep -q $'\n'; then
  # Multiple files selected - convert newlines to array
  readarray -t FILE_ARRAY <<<"$FILES"
  setsid localsend --headless send "${FILE_ARRAY[@]}" >/dev/null 2>&1 &
else
  # Single file or clipboard mode
  setsid localsend --headless send "$FILES" >/dev/null 2>&1 &
fi

# Note: Temporary file will remain until system cleanup for clipboard mode
# This ensures the file content is available for the LocalSend GUI

exit 0
