#!/bin/bash

# omyvoid:summary=Enable, disable, toggle, or recover the internal laptop display
# omyvoid:args=<on|off|toggle|recover>

source "${OMYVOID_PATH:-$HOME/.local/share/omyvoid}/default/i18n/init.sh"

TOGGLE="internal-monitor-disable"
TOGGLE_FLAG="$HOME/.local/state/omyvoid/toggles/hypr/$TOGGLE.conf"
MIRROR_TOGGLE="internal-monitor-mirror"

# Get internal monitor name dynamically
INTERNAL=$(hyprctl monitors -j | jq -r '.[] | select(.name | contains("eDP")).name' | head -n 1)

on() {
  if omyvoid-hyprland-toggle-enabled $TOGGLE; then
    omyvoid-hyprland-toggle $TOGGLE off
    omyvoid-notification-send -g 󰍹 "$I18N_MON_INTERNAL_ENABLED"
  fi
}

off() {
  if ! omyvoid-hw-external-monitors; then
    omyvoid-notification-send -g 󰍹 "$I18N_MON_INTERNAL_CANT_DISABLE"
    exit 1
  fi

  if omyvoid-hyprland-toggle-disabled $TOGGLE && omyvoid-hyprland-toggle-disabled $MIRROR_TOGGLE; then
    printf 'monitor = %s, disable\n' "$INTERNAL" >"$TOGGLE_FLAG"
    omyvoid-notification-send -g 󰍹 "$I18N_MON_INTERNAL_DISABLED"
    hyprctl reload
  fi
}

recover() {
  if ! omyvoid-hw-external-monitors && omyvoid-hyprland-toggle-enabled $TOGGLE; then
    omyvoid-hyprland-toggle $TOGGLE off
  fi
}

toggle() {
  if omyvoid-hyprland-toggle-enabled $TOGGLE; then
    on
  else
    off
  fi
}

case "$1" in
  on) on ;;
  off) off ;;
  toggle) toggle ;;
  recover) recover ;;
  *)
    echo "Usage: $(basename "$0") {on|off|toggle|recover}" >&2
    exit 1
    ;;
esac
