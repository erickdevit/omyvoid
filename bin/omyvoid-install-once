#!/bin/bash

# omyvoid:summary=Install the ONCE service, enable its background service, and launch the TUI.
# omyvoid:requires-sudo=true

set -euo pipefail
trap 'echo -e "\n❌ Error: Installation failed at line $LINENO." >&2' ERR

echo "Installing ONCE..."
omyvoid-pkg-add once-bin

if [[ -d /etc/sv/once-background ]]; then
  sudo ln -snf /etc/sv/once-background /var/service/once-background
  sudo sv up once-background
fi

echo -e "\n✅ Success: ONCE installed.\nLaunching ONCE..."
once
