#!/bin/bash

# omyvoid:summary=Check battery state and notify when it is low
# omyvoid:hidden=true

source "${OMYVOID_PATH:-$HOME/.local/share/omyvoid}/default/i18n/init.sh"

BATTERY_THRESHOLD=10
NOTIFICATION_FLAG="/run/user/$UID/omyvoid_battery_notified"
BATTERY_LEVEL=$(omyvoid-battery-remaining)
BATTERY_STATE=$(upower -i $(upower -e | grep 'BAT') | grep -E "state" | awk '{print $2}')

send_notification() {
  omyvoid-notification-send -g 󱐋 -u critical "$I18N_BATTERY_RECHARGE_TITLE" "$(printf "$I18N_BATTERY_RECHARGE_BODY" "$1")" -i battery-caution -t 30000
  omyvoid-hook battery-low "$1"
}

if [[ -n $BATTERY_LEVEL && $BATTERY_LEVEL =~ ^[0-9]+$ ]]; then
  if [[ $BATTERY_STATE == "discharging" ]] && (( BATTERY_LEVEL <= BATTERY_THRESHOLD )); then
    if [[ ! -f $NOTIFICATION_FLAG ]]; then
      send_notification $BATTERY_LEVEL
      touch $NOTIFICATION_FLAG
    fi
  else
    rm -f $NOTIFICATION_FLAG
  fi
fi
