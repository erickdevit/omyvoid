#!/bin/bash

# omyvoid:summary=Launch a URL as a web app in the default supported browser
# omyvoid:args=<url>

browser=$(xdg-settings get default-web-browser)

case $browser in
  chromium.desktop)
    ;;
  *)
    # Firefox does not support Chromium's --app mode.
    browser="chromium.desktop"
    ;;
esac

exec_path=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' \
  ~/.local/share/applications/"$browser" \
  ~/.nix-profile/share/applications/"$browser" \
  /usr/share/applications/"$browser" \
  /usr/local/share/applications/"$browser" 2>/dev/null | head -1)

exec setsid "$exec_path" --app="$1" "${@:2}"
