#!/bin/bash

# omyvoid:summary=Install Moonlight (NVIDIA GameStream / Sunshine client) for streaming games to this PC.
# omyvoid:requires-sudo=true

set -euo pipefail
trap 'echo -e "\n❌ Error: Installation failed at line $LINENO." >&2' ERR

echo "Installing Moonlight..."
omyvoid-pkg-add moonlight-qt

setsid gtk-launch com.moonlight_stream.Moonlight.desktop >/dev/null 2>&1 &

echo "✅ Success: Moonlight installed."
