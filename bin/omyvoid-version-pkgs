#!/bin/bash

# omyvoid:summary=Print when system packages were last upgraded

pkgdb=$(find /var/db/xbps -maxdepth 1 -type f -name 'pkgdb-*.plist' -print -quit 2>/dev/null)
if [[ -n $pkgdb ]]; then
  date -d "@$(stat -c %Y "$pkgdb")" "+%A, %B %d %Y at %H:%M"
else
  echo "XBPS package database not found" >&2
  exit 1
fi
