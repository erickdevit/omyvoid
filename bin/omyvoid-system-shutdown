#!/bin/bash

# omyvoid:summary=Shut down after closing application windows
# omyvoid:examples=omyvoid shutdown | omyvoid system shutdown
# omyvoid:aliases=omyvoid shutdown

omyvoid-state clear re*-required

# Schedule the shutdown to happen after closing windows (detached from terminal)
nohup bash -c "sleep 2 && loginctl poweroff" >/dev/null 2>&1 &

# Now close all windows
omyvoid-hyprland-window-close-all
sleep 1 # Allow apps like Chrome to shutdown correctly
