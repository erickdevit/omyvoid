#!/bin/bash

# omyvoid:summary=Launch Walker and ensure its Elephant data provider is running

if ! pgrep -f "$HOME/.local/bin/elephant" > /dev/null; then
  setsid "$HOME/.local/bin/elephant" &
fi

# Ensure walker service is running
if ! pgrep -f "$HOME/.local/bin/walker --gapplication-service" > /dev/null; then
  setsid env GSK_RENDERER=cairo "$HOME/.local/bin/walker" --gapplication-service &
fi

exec "$HOME/.local/bin/walker" --width 504 --maxheight 300 --minheight 300 "$@"
