#!/bin/bash

# omyvoid:summary=Reinstall the Limine EFI application and rebuild Omyvoid boot files
# omyvoid:group=boot
# omyvoid:name=repair
# omyvoid:requires-sudo=true

set -euo pipefail
(( EUID == 0 )) || exec sudo "$0" "$@"

[[ -f /etc/default/limine ]] && source /etc/default/limine
if [[ -z ${ESP_PATH:-} ]]; then
  if [[ $(findmnt -n -o FSTYPE /boot 2>/dev/null || true) == "vfat" ]]; then
    ESP_PATH="/boot"
  elif [[ $(findmnt -n -o FSTYPE /boot/efi 2>/dev/null || true) == "vfat" ]]; then
    ESP_PATH="/boot/efi"
  else
    ESP_PATH="/boot"
  fi
fi

limine_efi=/usr/share/limine/BOOTX64.EFI
[[ -f $limine_efi ]] || { echo "Limine EFI binary not found: $limine_efi" >&2; exit 1; }

mkdir -p "$ESP_PATH/EFI/Omyvoid" "$ESP_PATH/EFI/BOOT"
install -m 0644 "$limine_efi" "$ESP_PATH/EFI/Omyvoid/limine.efi"
install -m 0644 "$limine_efi" "$ESP_PATH/EFI/BOOT/BOOTX64.EFI"
rm -f "$ESP_PATH/EFI/Omyvoid/limine.conf" "$ESP_PATH/EFI/BOOT/limine.conf"
rm -rf "$ESP_PATH/EFI/void_grub" "$ESP_PATH/EFI/grub" "$ESP_PATH/EFI/Void" 2>/dev/null || true

boot_source=$(findmnt -n -o SOURCE "$ESP_PATH")
disk="/dev/$(lsblk -n -o PKNAME "$boot_source" | head -n 1)"
part=$(lsblk -n -o PARTN "$boot_source" | head -n 1)
if [[ -n $disk && -n $part && -d /sys/firmware/efi ]]; then
  while read -r entry; do
    number=${entry#Boot}
    number=${number%%[[:space:]]*}
    number=${number%\*}
    efibootmgr --bootnum "$number" --delete-bootnum || true
  done < <(efibootmgr 2>/dev/null | grep -Ei '^Boot[0-9A-Fa-f]+\*?[[:space:]]+(Omyvoid|void_grub|grub|Void)([[:space:]]|$)' || true)
  efibootmgr --create --disk "$disk" --part "$part" --label Omyvoid --loader '\EFI\Omyvoid\limine.efi'
fi

omyvoid-boot-refresh
