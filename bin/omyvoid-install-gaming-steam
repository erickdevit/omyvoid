#!/bin/bash

# omyvoid:summary=Install Steam and graphics drivers selected for this system
# omyvoid:requires-sudo=true

set -euo pipefail
trap 'echo -e "\n❌ Error: Installation failed at line $LINENO." >&2' ERR

echo "Installing Steam..."
omyvoid-pkg-add steam
omyvoid-install-gaming-gpu-lib32

echo ""
echo "Steam will start automatically now. This might take a while..."

setsid gtk-launch steam >/dev/null 2>&1 &

echo "✅ Success: Steam installed."
