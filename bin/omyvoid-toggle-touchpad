#!/bin/bash

# omyvoid:summary=Enable, disable, or toggle the touchpad
# omyvoid:args=[on|off|toggle]

source "${OMYVOID_PATH:-$HOME/.local/share/omyvoid}/default/i18n/init.sh"

STATE_FILE="$HOME/.local/state/omyvoid/toggles/hypr/touchpad-disabled.conf"

device="$(omyvoid-hw-touchpad)"

if [[ -z $device ]]; then
  echo "No touchpad device found" >&2
  exit 1
fi

enable() {
  hyprctl eval "hl.device({ name = \"$device\", enabled = true })" >/dev/null 2>&1 || hyprctl keyword "device:$device:enabled" true >/dev/null
  rm -f "$STATE_FILE"
  omyvoid-swayosd-client --custom-icon input-touchpad-symbolic --custom-message "$I18N_OSD_TOUCHPAD_ON"
}

disable() {
  hyprctl eval "hl.device({ name = \"$device\", enabled = false })" >/dev/null 2>&1 || hyprctl keyword "device:$device:enabled" false >/dev/null
  mkdir -p "$(dirname "$STATE_FILE")"
  printf 'device {\n  name = %s\n  enabled = false\n}\n' "$device" >"$STATE_FILE"
  omyvoid-swayosd-client --custom-icon touchpad-disabled-symbolic --custom-message "$I18N_OSD_TOUCHPAD_OFF"
}

case "${1:-toggle}" in
  on) enable ;;
  off) disable ;;
  toggle) if [[ -f $STATE_FILE ]]; then enable; else disable; fi ;;
esac
