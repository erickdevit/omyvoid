#!/bin/bash

# omyvoid:summary=Refresh XBPS repositories and execute pre-refresh hooks
# omyvoid:requires-sudo=true

channel="${1:-stable}"

if [[ $channel != "stable" && $channel != "rc" && $channel != "edge" && $channel != "dev" ]]; then
  echo "Error: Invalid channel '$channel'. Must be one of: stable, rc, edge, dev"
  exit 1
fi

echo "Refreshing XBPS repositories for channel: $channel"

# Run custom hooks before refreshing XBPS repositories.
if omyvoid-cmd-present omyvoid-hook; then
  omyvoid-hook pre-refresh-xbps
fi

# Update XBPS repository indexes
sudo xbps-install -Sy
