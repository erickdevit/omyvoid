#!/bin/bash

# omyvoid:summary=Set the default browser for Omyvoid and XDG handlers
# omyvoid:args=[chromium|firefox]
# omyvoid:examples=omyvoid default browser chromium | omyvoid default browser firefox

source "${OMYVOID_PATH:-$HOME/.local/share/omyvoid}/default/i18n/init.sh"

if (($# == 0)); then
  case "$(xdg-settings get default-web-browser)" in
  chromium.desktop) echo "chromium" ;;
  firefox.desktop) echo "firefox" ;;
  *) xdg-settings get default-web-browser ;;
  esac
  exit 0
fi

case "$1" in
chromium) desktop_id="chromium.desktop"; name="Chromium"; glyph="" ;;
firefox) desktop_id="firefox.desktop"; name="Firefox"; glyph="󰈹" ;;
*)
  echo "Usage: omyvoid-default-browser <chromium|firefox>"
  exit 1
  ;;
esac

xdg-settings set default-web-browser "$desktop_id"
xdg-mime default "$desktop_id" x-scheme-handler/http
xdg-mime default "$desktop_id" x-scheme-handler/https
xdg-mime default "$desktop_id" text/html

omyvoid-notification-send -g "$glyph" "$(printf "$I18N_BROWSER_DEFAULT_SET" "$name")"
