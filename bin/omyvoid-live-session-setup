#!/bin/bash

# omyvoid:summary=Apply live-session desktop defaults for the ISO
# omyvoid:hidden=true

set -euo pipefail

if [[ ! -d /run/initramfs/live && $USER != "omyvoid" ]]; then
  exit 0
fi

OMYVOID_PATH="${OMYVOID_PATH:-$HOME/.local/share/omyvoid}"
export OMYVOID_PATH
export PATH="$OMYVOID_PATH/bin:$PATH:$HOME/.local/bin"

mkdir -p "$HOME/.config/omyvoid/current" "$HOME/.config"

background="$HOME/.config/omyvoid/current/background"
if [[ ! -e $background && -f $HOME/.config/omyvoid/current/theme/backgrounds/omyvoidBackground.png ]]; then
  ln -snf "theme/backgrounds/omyvoidBackground.png" "$background"
fi

case " $(cat /proc/cmdline) " in
  *" omyvoid.autostart=installer "*) exec ghostty -e sudo omyvoid install ;;
  *" omyvoid.autostart=recovery "*) exec ghostty -e sudo omyvoid recovery ;;
esac

cat > "$HOME/.config/xdg-terminals.list" <<EOF
# Terminal emulator preference order for xdg-terminal-exec
# The first found and valid terminal will be used
Alacritty.desktop
EOF

omyvoid-theme-set-gnome >/dev/null 2>&1 || true
