#!/bin/bash

# omyvoid:summary=Install Zed Editor and configure it with the current Omyvoid theme

set -euo pipefail
trap 'echo -e "\n❌ Error: Installation failed at line $LINENO." >&2' ERR

echo "Installing Zed Editor from the Omyvoid XBPS repository..."
omyvoid-pkg-add zed

# Configure Zed settings
mkdir -p ~/.config/zed
if [[ ! -f ~/.config/zed/settings.json ]]; then
  echo -e '{\n  "theme": "One Dark"\n}' > ~/.config/zed/settings.json
fi

echo "✅ Success: Zed Editor installed."
# Launch Zed Editor
setsid zed &>/dev/null &
