#!/bin/bash

# omyvoid:summary=Check whether Btrfs swapfile hibernation is configured

[[ -f /sys/power/image_size && -f /swap/swapfile && -f /etc/default/limine ]] || exit 1
source /etc/default/limine
[[ " ${OMYVOID_KERNEL_CMDLINE:-} " == *" resume="* && " ${OMYVOID_KERNEL_CMDLINE:-} " == *" resume_offset="* ]]
