#!/bin/bash

# omyvoid:summary=Set the default editor for $EDITOR
# omyvoid:args=[code|sublime_text|helix|vim|emacs|nvim]
# omyvoid:examples=omyvoid default editor | omyvoid default editor code | omyvoid default editor helix

source "${OMYVOID_PATH:-$HOME/.local/share/omyvoid}/default/i18n/init.sh"

if (($# == 0)); then
  sed -n 's/^export EDITOR=//p' ~/.config/omyvoid/environment | head -n 1
  exit 0
fi

case "$1" in
code) editor="code"; name="VSCode"; glyph="" ;;
sublime_text) editor="sublime_text"; name="Sublime Text"; glyph="" ;;
helix) editor="helix"; name="Helix"; glyph="" ;;
vim) editor="vim"; name="Vim"; glyph="" ;;
emacs) editor="emacs"; name="Emacs"; glyph="" ;;
nvim) editor="nvim"; name="Neovim"; glyph="" ;;
*)
  echo "Usage: omyvoid-default-editor <code|sublime_text|helix|vim|emacs|nvim>"
  exit 1
  ;;
esac

sed -i "s/^export EDITOR=.*/export EDITOR=$editor/" ~/.config/omyvoid/environment

export EDITOR="$editor"
omyvoid-notification-send -g "$glyph" "$(printf "$I18N_EDITOR_DEFAULT_SET_TITLE" "$name")" "$I18N_EDITOR_DEFAULT_SET_BODY"
