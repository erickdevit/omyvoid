#!/bin/bash

# omyvoid:summary=Set Ghostty terminal cursor style to normal or slanted (with trail)
# omyvoid:args=<normal|slanted>
# omyvoid:examples=omyvoid-style-terminal-cursor normal | omyvoid style terminal-cursor slanted

source "${OMYVOID_PATH:-$HOME/.local/share/omyvoid}/default/i18n/init.sh"

if [[ $1 != "normal" && $1 != "slanted" ]]; then
  echo "Usage: omyvoid-style-terminal-cursor <normal|slanted>" >&2
  exit 1
fi

set_config() {
  local file="$1"
  if [[ -f $file ]]; then
    sed -i '/cursor-opacity/d' "$file"
    sed -i '/custom-shader/d' "$file"
    
    if [[ $2 == "slanted" ]]; then
      cat << 'EOF' >> "$file"
cursor-opacity = 0
custom-shader = "~/.config/ghostty/shaders/cursor_tail.glsl"
custom-shader-animation = always
EOF
    fi
  fi
}

set_config "$HOME/.config/ghostty/config" "$1"

if pgrep -x ghostty >/dev/null; then
  pkill -SIGUSR2 ghostty
fi

case $1 in
  normal) omyvoid-notification-send "$I18N_STYLE_CURSOR_NORMAL" -g 󰳽 || true ;;
  slanted) omyvoid-notification-send "$I18N_STYLE_CURSOR_SLANTED" -g 󰳽 || true ;;
esac
