#!/bin/bash

# omyvoid:summary=Set the branch for Omyvoid's git repository.
# omyvoid:args=<main|rc|dev>

if (($# == 0)); then
  echo "Usage: omyvoid-branch-set [main|rc|dev]"
  exit 1
else
  branch="$1"
fi

if [[ $branch != "main" && $branch != "rc" && $branch != "dev" ]]; then
  echo "Error: Invalid branch '$branch'. Must be one of: main, rc, dev"
  exit 1
fi

git -C $OMYVOID_PATH switch $branch
