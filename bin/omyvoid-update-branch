#!/bin/bash

# omyvoid:summary=Switch Omyvoid branches and update from the selected branch
# omyvoid:args=<branch>

set -e

if (($# == 0)); then
  echo "Usage: omyvoid-update-branch [main|rc|dev]"
  exit 1
fi

branch="$1"

# Snapshot before switching branch
omyvoid-snapshot create || (( $? == 127 ))

if ! git -C "$OMYVOID_PATH" diff --quiet || ! git -C "$OMYVOID_PATH" diff --cached --quiet; then
  stashed=true
  git -C "$OMYVOID_PATH" stash push -u -m "Autostash before switching to $branch"
else
  stashed=false
fi

# Switch branches
git -C "$OMYVOID_PATH" switch "$branch"

# Reapply stash if we made one
if [[ $stashed == "true" ]]; then
  if ! git -C "$OMYVOID_PATH" stash pop; then
    echo "⚠️ Conflicts when applying stash — stash kept"
  fi
fi

# Update the system from the new branch
omyvoid-update-perform
