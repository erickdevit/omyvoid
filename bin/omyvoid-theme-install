#!/bin/bash

# omyvoid:summary=Install a theme from a git repository
# omyvoid:args=[git-repo-url]
# omyvoid:examples=omyvoid theme install https://github.com/example/omyvoid-example-theme.git
# omyvoid:examples=omyvoid theme install git@github.com:example/omyvoid-example-theme.git

set -euo pipefail
trap 'echo -e "\n❌ Error: Installation failed at line $LINENO." >&2' ERR

source "${OMYVOID_PATH:-$HOME/.local/share/omyvoid}/default/i18n/init.sh"

if [[ -z $1 ]]; then
  echo -e "\e[32m$I18N_THEME_INSTALL_INTRO\n\e[0m"
  REPO_URL=$(gum input --placeholder="$I18N_THEME_INSTALL_PLACEHOLDER" --header="")
else
  REPO_URL="$1"
fi

if [[ -z $REPO_URL ]]; then
  exit 1
fi

THEMES_DIR="$HOME/.config/omyvoid/themes"

# Strip user@host: prefix from scp-style SSH URLs so basename sees just the path
REPO_PATH="$REPO_URL"
[[ $REPO_PATH != *"://"* && $REPO_PATH == *:*/* ]] && REPO_PATH="${REPO_PATH#*:}"
THEME_NAME=$(basename "$REPO_PATH" .git | sed -E 's/^omyvoid-//; s/-theme$//' | tr '[:upper:]' '[:lower:]')
THEME_PATH="$THEMES_DIR/$THEME_NAME"

# Remove existing theme if present
if [[ -d $THEME_PATH ]]; then
  rm -rf "$THEME_PATH"
fi

# Clone the repo directly to ~/.config/omyvoid/themes
if ! git clone "$REPO_URL" "$THEME_PATH"; then
  echo "$I18N_THEME_INSTALL_ERR_CLONE"
  exit 1
fi

# Apply the new theme with omyvoid-theme-set
omyvoid-theme-set $THEME_NAME
echo "✅ Success: Theme installed."
