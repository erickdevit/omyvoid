#!/bin/bash

# omyvoid:summary=Launch a floating terminal with the Omyvoid presentation wrapper
# omyvoid:args=<command>

cmd="$*"
exec setsid xdg-terminal-exec --app-id=org.omyvoid.terminal --title=Omyvoid -e bash -c "omyvoid-show-logo; $cmd; EXIT_CODE=\$?; if (( EXIT_CODE == 0 )); then omyvoid-show-done; elif (( EXIT_CODE != 130 )); then omyvoid-show-error-wait; fi"
