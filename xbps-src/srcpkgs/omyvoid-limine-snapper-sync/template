# Template file for 'omyvoid-limine-snapper-sync'
pkgname=omyvoid-limine-snapper-sync
version=0.1.0.dev.1
revision=1
archs=noarch
depends="bash btrfs-progs snapper libnotify"
short_desc="Omyvoid Snapper retention, Limine synchronization and root rollback"
maintainer="Erick Dev <erickdevit@users.noreply.github.com>"
license="MIT"

do_install() {
  vbin "${FILESDIR}/omyvoid-snapshot"
  vinstall "${FILESDIR}/root" 0644 etc/snapper/configs
  vinstall "${FILESDIR}/omyvoid-snapshot-notify.desktop" 0644 etc/xdg/autostart
}
