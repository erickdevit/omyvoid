# Editor used by CLI
export SUDO_EDITOR="$EDITOR"
export BAT_THEME=ansi

# Color man pages with bat
export MANROFFOPT="-c"
export MANPAGER="sh -c 'col -bx | bat -l man -p'"

# Available in graphical sessions and SSH sessions.
export OMYVOID_PATH=$HOME/.local/share/omyvoid
export PATH=$OMYVOID_PATH/bin:$PATH:$HOME/.local/bin

[[ -f ~/.config/omyvoid/environment ]] && source ~/.config/omyvoid/environment
